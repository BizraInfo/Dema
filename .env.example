DEMA_HOME=~/.dema
DEMA_MODE=local
# Optional but required before opening private local DEMA surfaces.
# Use a random value of at least 32 bytes; it is never committed or returned.
# DEMA_LOCAL_AUTH_SECRET=
# Alternatively, set AUTH_PROVIDER=local and AUTH_SECRET in the operator environment.
# Optional. Run this from your BIZRA/Node0 runtime root, or leave unset to use Dema's safe local status stub.
DEMA_NODE0_STATUS_COMMAND=python -m core.sovereign node0 status --json --root sovereign_state/dema
