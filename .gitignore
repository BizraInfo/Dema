node_modules
dist/
.DS_Store
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.dema/
coverage/
# CONFIG-SLICE-A: the stable repo Claude harness (rules/, agents/, skills/,
# hooks/*.mjs, settings.json) is tracked and reviewable. Only volatile or
# machine-local state stays off-tree.
.claude/hooks/logs/
.claude/bus/
.claude/.cc-writes/
.claude/settings.local.json
.claude/skills/dema-slice-scaffold-workspace/
.claude/workflows/
.claude/worktrees/
.vscode/
.artifacts/
.qodo/

# Downloaded/generated CI receipt evidence. Keep on disk for operator review,
# but do not let local proof artifacts dirty the source tree.
artifacts/receipts/ci/

# Node0 Mumu closed-loop runtime output (ADR-037: runtime artifacts are not
# committed — they are run output, not source).
artifacts/node0/mumu/

# OpenTimestamps creates *.ots.bak backups on each `ots upgrade` —
# regenerable cruft, never the canonical receipt.
*.ots.bak

# External reference projects — Dema stands on the shoulders, does not ingest.
hermes-agent-2026.4.23/
openclaw-2026.4.25/

# proof-forge local evidence — generated artifacts stay off-tree until an ADR
# reconciles them with the ~/.dema/receipts spine (ADR-002, ADR-005).
.proof-forge/
PROOF_SUMMARY.md

# Vercel deploy staging — produced by scripts/build/vercel-publish.sh on the
# Vercel runner only; never committed. Operator's install path is unaffected.
public/
.vercel/

# Local scratch/reference export, not repo documentation.
what is bash , why its the most important and most (1).md

# Skill bundles authored locally (zip archives with SKILL.md + references/).
# These are operator-authored artifacts intended for ~/.claude/skills/ install,
# not repo-tracked content. Filed as artifact-type policy: skill bundles live
# outside the source tree.
*.skill

# Local agent run outputs. Source hooks/skills may be tracked; generated logs
# and evaluation workspaces stay off-tree.
.codex/hooks/logs/
.agents/skills/*-workspace/

# Generated root-level Codex session captures can contain transient credentials.
/codex-session-*.md

# Root-level scratch screenshot from operator review; bind explicitly in docs
# before tracking as evidence.
/bizra-ai-screenshot.png

# Design-export bundle (2026-07-08). Selective text/design source integrated
# under docs/design/proof-state-runtime/. Heavy binaries (PNG/PDF) + zip stay
# out of history — see that dir's README for the excluded-asset manifest.
/BIZRA proof-state runtime/
/BIZRA proof-state runtime.zip

# dema-ui Next.js app: generated/deps stay off-tree
packages/dema-ui/node_modules/
packages/dema-ui/.next/
packages/dema-ui/dev.log

# Agent-flow tool state directories (claude-flow, kiro) — machine-local tool
# runtime data, never source.
.claude-flow/
.kiro/

# Root-level opencode session captures can contain transient credentials.
/session-ses_*.md
/proof-of-promotion/
.local/
.claude/skills/dema-data-steward/
