{
  "$id": "bizra.dema.proof_room_bundle.v0.1",
  "title": "Proof Room Bundle v0.1",
  "description": "Verdict envelope from packages/core/src/proof-room-bundle.js buildProofRoomBundle() and redactProofRoomBundle(). Layer 1 aggregate gate composition. Redacted variant uses truth_label=PUBLIC_SAFE, emits the stable Dema product label instead of a raw worktree basename, and adds repo_root_sha256 + redacted=true.",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "truth_label",
    "ok",
    "generated_at",
    "repo_root",
    "gates",
    "self_harness",
    "proof_convergence",
    "boundary",
    "next_safe_action"
  ],
  "properties": {
    "schema": { "const": "bizra.dema.proof_room_bundle.v0.1" },
    "mode": { "enum": ["PROOF_ROOM_FULL", "PROOF_ROOM_CORE"] },
    "truth_label": { "enum": ["MEASURED", "GATE_FAILURE", "PUBLIC_SAFE"] },
    "ok": { "type": "boolean" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "repo_root": { "type": "string" },
    "gates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "self_harness": { "type": "object" },
    "proof_convergence": {
      "type": "object",
      "required": ["formal", "cryptographic", "empirical", "economic"],
      "properties": {
        "formal": { "type": "string" },
        "cryptographic": { "type": "string" },
        "empirical": { "type": "string" },
        "economic": { "type": "string" }
      }
    },
    "boundary": {
      "type": "object",
      "required": [
        "filesystem_write_performed",
        "network_used",
        "runtime_execution_performed",
        "model_loaded",
        "model_invocation_performed",
        "prompt_executed",
        "external_call_performed",
        "raw_corpus_scan_performed",
        "raw_data_included",
        "tool_executed",
        "chain_advance_performed",
        "receipt_mint_performed",
        "federation_invoked",
        "node_connection_performed",
        "public_network_used",
        "consent_collected"
      ],
      "properties": {
        "filesystem_write_performed": { "const": false },
        "network_used": { "const": false },
        "runtime_execution_performed": { "const": false },
        "model_loaded": { "const": false },
        "model_invocation_performed": { "const": false },
        "prompt_executed": { "const": false },
        "external_call_performed": { "const": false },
        "raw_corpus_scan_performed": { "const": false },
        "raw_data_included": { "const": false },
        "tool_executed": { "const": false },
        "chain_advance_performed": { "const": false },
        "receipt_mint_performed": { "const": false },
        "federation_invoked": { "const": false },
        "node_connection_performed": { "const": false },
        "public_network_used": { "const": false },
        "consent_collected": { "const": false }
      }
    },
    "next_safe_action": { "type": "string" },
    "redacted": { "type": "boolean" },
    "repo_root_basename": { "type": "string" },
    "repo_root_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
