{
  "$id": "bizra.dema.eval_layer2_judge_verdict.v0.1",
  "title": "Eval Layer 2 Judge Verdict v0.1",
  "description": "Paste-back verdict from an external LLM judge. Validated structurally by envelope-schema-validator and semantically by eval-layer2-verdict-validator.validatePastedJudgeVerdict(). v0.1 accepts judge_origin=external_paste_back only; local_model_designed_not_live is reserved for v0.2.",
  "type": "object",
  "required": [
    "schema",
    "rubric_id",
    "judged_artifact_sha256",
    "score",
    "evidence_excerpt",
    "judge_origin",
    "judged_at"
  ],
  "properties": {
    "schema": { "const": "bizra.dema.eval_layer2_judge_verdict.v0.1" },
    "rubric_id": {
      "enum": ["truthfulness", "actionability", "boundary_compliance"]
    },
    "judged_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "score": { "enum": [0, 1, 2] },
    "evidence_excerpt": { "type": "string" },
    "judge_origin": {
      "enum": ["external_paste_back", "local_model_designed_not_live"]
    },
    "judged_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
    },
    "judge_model_name": { "type": "string" },
    "judge_run_id": { "type": "string" },
    "notes": { "type": "string" }
  }
}
