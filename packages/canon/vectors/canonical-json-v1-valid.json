      "description": "~1.0 MB payload under MAX_CANONICAL_BYTES, accepted",
      "generator": {
        "type": "array_of_strings",
        "count": 1000,
        "char": "a",
        "repeat": 1000
      },
      "expected_byte_length": 1003001,
