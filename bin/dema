#!/usr/bin/env node
// Global `dema` entry point. Installed via `npm install -g .` (per package.json `bin` field).
// Delegates to apps/cli/src/index.js, except for the documented health mission route,
// which must be selected before the generic `mission run <file>` branch can interpret
// the literal token `health` as a filename.
// AUDIT P2: surface a load-time failure instead of an unhandled promise rejection.

async function runHealthMission(argv) {
  const {
    buildHealthSnapshot,
    saveHealthSnapshotReceipt,
    formatHealthSnapshotReceipt,
  } = await import("../packages/mission/src/health-snapshot.js");

  const argValue = (name) => {
    const index = argv.indexOf(name);
    return index >= 0 ? argv[index + 1] : undefined;
  };
  const dryRun = argv.includes("--dry-run");
  const consent = argValue("--consent") ?? "";
  const wantsJson = argv.includes("--json") || !process.stdout.isTTY;

  let result;
  if (dryRun && !consent) {
    const snapshot = await buildHealthSnapshot();
    result = { ...snapshot, saved: false, reason: "dry_run", dry_run: true };
  } else {
    result = await saveHealthSnapshotReceipt({ consent, dryRun });
  }

  if (wantsJson) console.log(JSON.stringify(result, null, 2));
  else console.log(formatHealthSnapshotReceipt(result));

  if (!result.saved && result.reason !== "dry_run") process.exitCode = 1;
}

async function main() {
  const argv = process.argv.slice(2);
  if (argv[0] === "mission" && argv[1] === "run" && argv[2] === "health") {
    await runHealthMission(argv);
    return;
  }
  await import("../apps/cli/src/index.js");
}

main().catch((err) => {
  console.error(err && err.stack ? err.stack : err);
  process.exitCode = 1;
});
