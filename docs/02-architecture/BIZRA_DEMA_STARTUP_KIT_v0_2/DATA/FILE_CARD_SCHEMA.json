{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizra.local/schemas/file_card.v0.1.json",
  "type": "object",
  "required": ["schema", "file_id", "source_system", "source_id", "root_id", "relative_path", "object_type", "promotion_status", "authority_delta"],
  "properties": {
    "schema": {"const": "bizra.dema.file_card.v0.1"},
    "file_id": {"type": "string"},
    "source_system": {"type": "string"},
    "source_id": {"type": "string"},
    "root_id": {"type": "string"},
    "relative_path": {"type": "string"},
    "object_type": {"enum": ["file", "dir", "symlink", "other"]},
    "bytes": {"type": "integer", "minimum": 0},
    "mtime_ns": {"type": ["integer", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "logical_zone": {"type": "string"},
    "epistemic_status": {"type": "string"},
    "promotion_status": {"type": "string"},
    "duplicate_of": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]},
    "receipt_refs": {"type": "array", "items": {"type": "string"}},
    "authority_delta": {"const": 0}
  },
  "additionalProperties": true
}
