{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizra.local/schemas/knowledge_card.v0.1.json",
  "type": "object",
  "required": ["schema", "knowledge_id", "kind", "statement", "source_refs", "epistemic_status", "verification_path"],
  "properties": {
    "schema": {"const": "bizra.dema.knowledge_card.v0.1"},
    "knowledge_id": {"type": "string"},
    "kind": {"enum": ["CLAIM", "DECISION", "INVARIANT", "PROCEDURE", "FAILURE", "BENCHMARK", "RECEIPT_REF", "OPEN_QUESTION", "GOLDEN_GEM"]},
    "statement": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "epistemic_status": {"enum": ["VERIFIED", "MEASURED", "SOURCE_BOUND", "INFERENCE", "ASSUMPTION", "HYPOTHESIS", "UNKNOWN", "CONTRADICTION", "SUPERSEDED"]},
    "verification_path": {"type": "string"},
    "contradicts": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "last_verified_at": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
